    "check": "node --check scripts/migrate-supabase.js && node --check netlify/functions/*.js"
  },
  "dependencies": {
    "@netlify/blobs": "^8.2.0",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "pg": "^8.13.0",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "netlify-cli": "^17.36.2"
  }
}
