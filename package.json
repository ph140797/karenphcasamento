{
  "name": "karen-ph-casamento",
  "version": "1.0.0",
  "private": true,
  "description": "Wedding website for Karen and Paulo Henrique with Netlify Functions, Stripe Checkout, and gift admin APIs.",
  "scripts": {
    "build": "npm run check",
    "dev": "netlify dev",
    "migrate": "node scripts/migrate-supabase.js",
