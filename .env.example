# Required for Stripe Checkout
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
URL=https://your-netlify-site.netlify.app

# Required for admin API access
ADMIN_TOKEN=change-this-long-random-token

# Optional: use Supabase as the database.
# If omitted, Netlify Blobs stores orders/gifts.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required only for deploy-time migrations.
# Option A is recommended for Netlify deploy migrations:
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Option B, if using Supabase Management API:
SUPABASE_ACCESS_TOKEN=sbp_xxx
SUPABASE_PROJECT_REF=your-project-ref

# Optional Stripe product behavior
STRIPE_CURRENCY=brl
PIX_KEY=11953396177
PIX_QR_CODE_IMAGE_URL=/assets/pix-qr-code.png

# Google Sheets RSVP integration (OAuth 2.0 Web application)
GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX_xxx
GOOGLE_OAUTH_REDIRECT_URI=https://your-netlify-site.netlify.app/api/google-oauth-callback
GOOGLE_SHEETS_SPREADSHEET_ID=1RJBhCgQwr-Aub-fdRriy0ZV5jxgi6vy06ndXYvCsyW4
GOOGLE_SHEETS_RANGE=A:D
